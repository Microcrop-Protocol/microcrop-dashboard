# API Configuration
# Development
VITE_API_URL=http://localhost:3000

# Production (uncomment for production builds)
# VITE_API_URL=https://api.microcrop.app

# Mapbox (required for map features)
# Get your token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Partner documentation site (Mintlify), e.g. https://docs.microcrop.app — NO trailing slash.
# OPTIONAL and off by default. When unset the "API docs" sidebar link is HIDDEN rather than
# rendered dead: the docs site is not deployed yet, and a nav item pointing at a host that does
# not resolve is worse than no nav item, because the partner cannot tell our outage from their
# own network. Set this to the deployed docs origin to switch the link on.
VITE_DOCS_URL=

# Marketing site origin, used by the auth pages' footer to link the privacy policy.
# OPTIONAL — defaults to https://microcrop.app. Set it only for a preview environment that
# should point at a different marketing deployment. Must be an absolute http(s) origin; a
# bare host or relative path is ignored and the default is used.
VITE_MARKETING_URL=

# Terms of service URL, e.g. https://microcrop.app/terms.
# OPTIONAL and EMPTY ON PURPOSE. There is no published terms page and no counsel-approved
# terms copy, so the auth footer renders "Terms" as plain muted text rather than a link.
# Leave this blank until the page actually exists — a dead /terms link on the sign-in page
# of an insurance product reads as a missing legal document. Setting it to a real absolute
# URL turns the footer entry into a link, with no code change.
VITE_TERMS_URL=

# Google sign-in. OPTIONAL and OFF.
# The BACKEND DOES NOT IMPLEMENT GOOGLE OAUTH — there is no /auth/google route, no callback
# handler and no client id. While this is unset the "Continue with Google" button renders
# visible but inert, with an on-screen explanation, so nobody ships a control that looks
# live and silently fails. DO NOT set this to "true" until the backend routes exist and
# issue the same token pair POST /auth/login returns; the flag only moves the switch, it
# does not implement the flow. Any value other than "true" leaves the button off.
VITE_GOOGLE_AUTH_ENABLED=

# Settlement chain. BASE IS RETIRED (2026-10-19): Stellar (Soroban) is the only chain MicroCrop
# records on, and on Stellar MicroCrop never holds funds (the insurer settles; MicroCrop verifies
# and records).
#
# VITE_STELLAR_NETWORK — testnet | public. The network stellar.expert links open on when a record
# does not name its own (a notary receipt does, and its own network always wins). Default testnet.
VITE_STELLAR_NETWORK=
#
# VITE_BASE_SETTLEMENT_ENABLED — the phase-1 Base kill switch, mirroring the backend's
# BASE_SETTLEMENT_ENABLED. Unset/anything but "true" (the default) hides every Base-only surface:
# org wallet provisioning, the on-chain reserve ratio and reserve read, the platform Treasury
# page, and BaseScan links (legacy Base hashes render as plain text). Set "true" ONLY together
# with the backend switch, or every Base action answers 409 BASE_RETIRED.
VITE_BASE_SETTLEMENT_ENABLED=
#
# VITE_EXPLORER_BASE_URL — BaseScan origin for legacy Base links; used only when the switch above
# is "true". Default https://basescan.org.
VITE_EXPLORER_BASE_URL=
