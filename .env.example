# API Configuration
# Development
VITE_API_URL=http://localhost:3000

# Production (uncomment for production builds)
# VITE_API_URL=https://api.microcrop.app

# Mapbox (required for map features)
# Get your token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Partner documentation site (Mintlify), e.g. https://docs.microcrop.app — NO trailing slash.
# OPTIONAL and off by default. When unset the "API docs" sidebar link is HIDDEN rather than
# rendered dead: the docs site is not deployed yet, and a nav item pointing at a host that does
# not resolve is worse than no nav item, because the partner cannot tell our outage from their
# own network. Set this to the deployed docs origin to switch the link on.
VITE_DOCS_URL=
